package-lock=true
; FIXME Set legacy-peer-deps=false when we upgrade RN.
legacy-peer-deps=true

; AAuti private feed for the @aauti/* scope (e.g. @aauti/whiteboard-sdk).
; AZURE_DEVOPS_PAT_TOKEN must be set in your shell env to a PAT with
; the Packaging (Read) scope on the `aauti` feed before `npm install`.
;   PowerShell:  $env:AZURE_DEVOPS_PAT_TOKEN = '<your PAT>'
;   Bash:        export AZURE_DEVOPS_PAT_TOKEN='<your PAT>'
; The marketplace repo bakes the token into its .npmrc directly because it
; lives on internal Azure DevOps; this repo is mirrored to GitHub where
; push-secret-scanning rejects any committed token. Env-var substitution
; keeps the token out of git history.
@aauti:registry=https://pkgs.dev.azure.com/aauti/_packaging/aauti/npm/registry/
//pkgs.dev.azure.com/aauti/_packaging/aauti/npm/registry/:_authToken=${AZURE_DEVOPS_PAT_TOKEN}
