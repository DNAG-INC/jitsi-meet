package-lock=true
; FIXME Set legacy-peer-deps=false when we upgrade RN.
legacy-peer-deps=true

; Registry configuration mirrors aauti-platform so both repos resolve the same
; scopes the same way.

; Credentials deliberately are NOT here. This repo is mirrored to GitHub, whose
; push protection refuses any push carrying a token. Put your PAT
; (read:packages) in your USER-level ~/.npmrc, which is never committed:
;   npm config set "//npm.pkg.github.com/:_authToken" "<your PAT>" --location=user
;
; Do NOT add an _authToken line here, even via an env var: a project .npmrc
; overrides the user one for the same key, so an unset variable resolves to an
; EMPTY token and masks the valid credentials in ~/.npmrc.
;
; Docker builds are unaffected - .npmrc is in .dockerignore and the image
; synthesises its own from the GIT_HUB_PACKAGES_TOKEN build-arg.

registry=https://registry.npmjs.org/
@dnag-inc:registry=https://npm.pkg.github.com/
@unrs:registry=https://registry.npmjs.org/
legacy-peer-deps=true
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
